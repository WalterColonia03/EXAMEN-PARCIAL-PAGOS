# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<genera-una-clave-larga-y-aleatoria>
DJANGO_ALLOWED_HOSTS=.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Correo transaccional: TurboSMTP API v2 y un remitente previamente verificado.
# Nunca uses claves reales en este archivo ni la contraseña de un buzón personal.
DJANGO_EMAIL_BACKEND=identity.email_backends.TurboSMTPEmailBackend
TURBOSMTP_API_URL=https://api.turbo-smtp.com/api/v2/mail/send
TURBOSMTP_CONSUMER_KEY=<consumer-key-de-turbosmtp>
TURBOSMTP_CONSUMER_SECRET=<consumer-secret-de-turbosmtp>
TURBOSMTP_TIMEOUT=10
# Evita invalidar un código recién enviado por solicitudes repetidas.
EMAIL_RECOVERY_RESEND_COOLDOWN_SECONDS=60
DJANGO_DEFAULT_FROM_EMAIL=PagoControl <acceso@tu-dominio-verificado.com>

# Alternativa SMTP si no se usa TurboSMTP API:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.tu-proveedor.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=1
# DJANGO_EMAIL_HOST_USER=<usuario-smtp>
# DJANGO_EMAIL_HOST_PASSWORD=<clave-smtp>
# DJANGO_EMAIL_TIMEOUT=10

# Supabase Database: usa el URI del Transaction pooler para Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?sslmode=require

# Supabase Storage: bucket privado y credenciales S3 exclusivas del servidor.
SUPABASE_STORAGE_BUCKET=pagocontrol-private
SUPABASE_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<project-region>
SUPABASE_S3_ACCESS_KEY_ID=<server-side-access-key>
SUPABASE_S3_SECRET_ACCESS_KEY=<server-side-secret-key>
SUPABASE_SIGNED_URL_TTL=60
